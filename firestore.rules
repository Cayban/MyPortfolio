rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Content is maintained locally; content management is disabled.
    match /projects/{id} { allow read, write: if false; }
    match /experience/{id} { allow read, write: if false; }
    match /certifications/{id} { allow read, write: if false; }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','rating','comment','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 300
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
  }
}
